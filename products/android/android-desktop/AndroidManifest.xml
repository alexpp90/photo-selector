<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!--
      No permissions are declared, and INTERNET in particular is not. The merged manifest
      is held to the same rule: LegalLinksTest fails if a dependency adds a permission.
      Every photograph is read through the Storage Access Framework grant the
      photographer hands over, all analysis is on-device (OpenCV via JNI), and nothing is uploaded anywhere.
    -->

    <!--
      Large screens only ([USER 2026-11-12] decision #5, REQ-AND-PLATFORM.02): Google Play has no
      screen-size rule of its own, so this element is what keeps Frameduel off phones (DeX phones
      fall out with it). Narrow windows on a tablet, Chromebook or DeX desktop are unaffected: the
      filter is the device's screen, not the window. ManifestScreenSizeTest reads the merged manifest.
    -->
    <supports-screens
        android:smallScreens="false"
        android:normalScreens="false"
        android:largeScreens="true"
        android:xlargeScreens="true" />

    <!-- Touchscreen not required — supports Samsung DeX mouse input -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Camera not required — Googlebooks, clamshell Chromebooks and DeX desktop docks may lack rear cameras -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".PhotoSelectorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSelectorToolbox">

        <!-- Samsung DeX: keep density when switching modes -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboard|screenLayout|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="768dp"
                android:minWidth="600dp"
                android:minHeight="480dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
