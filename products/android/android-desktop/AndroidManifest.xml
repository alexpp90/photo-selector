<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">


    <!--
      No permissions are declared, and INTERNET in particular is not.
      Every photograph is read through the Storage Access Framework grant the
      photographer hands over, all analysis is on-device (OpenCV via JNI), and nothing is uploaded anywhere.
    -->

    <!-- Touchscreen not required — supports Samsung DeX mouse input -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Camera not required — Googlebooks, clamshell Chromebooks and DeX desktop docks may lack rear cameras -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <application
        android:name=".PhotoSelectorApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PhotoSelectorToolbox">

        <!-- Samsung DeX: keep density when switching modes -->
        <meta-data
            android:name="com.samsung.android.keepalive.density"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:configChanges="orientation|screenSize|keyboard|screenLayout|smallestScreenSize|density"
            android:windowSoftInputMode="adjustResize">
            <layout
                android:defaultWidth="1024dp"
                android:defaultHeight="768dp"
                android:minWidth="600dp"
                android:minHeight="480dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
