<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme — actual theming is handled by Jetpack Compose Material 3.
         Window background, status and navigation bars follow the neutral studio canvas. -->
    <style name="Theme.PhotoSelectorToolbox" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/studio_canvas</item>
        <item name="android:statusBarColor">@color/studio_canvas</item>
        <item name="android:navigationBarColor">@color/studio_canvas</item>
    </style>
</resources>
