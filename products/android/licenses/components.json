      "url": "https://opensource.org/licenses/BSD-3-Clause",
      "file": "BSD-3-Clause.txt"
    },
    "libpng": {
      "name": "libpng License (PNG Reference Library License)",
      "url": "",
      "file": "libpng.txt"
    },
    "libjpeg-turbo": {
      "name": "libjpeg-turbo licences (IJG and Modified BSD)",
      "url": "",
      "file": "libjpeg-turbo.txt"
    },
    "libtiff": {
      "name": "libtiff License",
      "url": "",
      "file": "libtiff.txt"
    },
    "libwebp": {
      "name": "libwebp BSD 3-Clause License",
      "url": "",
      "file": "libwebp.txt"
    },
    "openjpeg": {
      "name": "OpenJPEG BSD 2-Clause License",
      "url": "",
      "file": "openjpeg.txt"
    },
    "zlib": {
      "name": "zlib License",
      "url": "",
      "file": "zlib.txt"
    },
    "OpenCV-BSD-3-Clause": {
      "name": "OpenCV (Carotene) BSD 3-Clause License",
      "url": "",
      "file": "OpenCV-BSD-3-Clause.txt"
    },
    "LLVM-Exception": {
      "name": "LLVM Exceptions to the Apache 2.0 License",
      "url": "",
      "file": "LLVM-Exception.txt"
    }
  },
