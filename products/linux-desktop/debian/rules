#!/usr/bin/make -f
#
# Source-package recipe for a Debian archive build. The .deb that Blitzlens releases is built by
# scripts/package_deb.py (pure Python, the default; --native uses dpkg-deb); CI does not run this
# file, so keep it in step by hand when the layout changes.

export PYBUILD_NAME = photo-selector-linux
export PYBUILD_SYSTEM = pyproject

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	# Run headless unit test suite during package build
	dh_auto_test -- --test-pytest --test-args="tests/unit"
